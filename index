<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>stars - Roblox Economy & Operations Portfolio</title>
<meta name="description" content="Portfolio of stars, covering Roblox game economies, development operations, community leadership and marketing.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap" rel="stylesheet">
<style>
:root{--ink:#000;--paper:#fff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--paper);color:var(--ink);font:400 clamp(1rem,.5vw + .9rem,1.2rem)/1.6 "Bricolage Grotesque",Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
::selection{background:var(--ink);color:var(--paper)}
:focus-visible{outline:2px solid currentColor;outline-offset:4px}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;text-align:left}
button{cursor:pointer}
p{margin:0}
#ink-cursor{position:fixed;left:0;top:0;width:18px;height:18px;transform:translate(-50%,-50%);border-radius:50%;background:#fff;mix-blend-mode:difference;pointer-events:none;opacity:0;z-index:10000;transition:width .18s ease,height .18s ease,opacity .12s ease}
html.ink-cursor-active,html.ink-cursor-active *{cursor:none!important}
html.ink-cursor-active #ink-cursor{opacity:1}
#ink-cursor.hovering{width:28px;height:28px}

nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:1.2rem 4vw;color:#fff;mix-blend-mode:difference;font-weight:500}
nav .links{display:flex;gap:clamp(1rem,3vw,2.2rem)}
nav a{display:inline-block;transition:transform .25s ease;background:linear-gradient(currentColor,currentColor) 0 100%/0 1.5px no-repeat;transition:background-size .35s,transform .25s}
nav a:hover{background-size:100% 1.5px}

.hero{min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding:7rem 4vw 3.5vw}
.h1{margin:0 0 3vw -.03em;font-size:clamp(5.5rem,29vw,36rem);line-height:.78;letter-spacing:-.045em;user-select:none}
.h1 span{display:inline-block;font-variation-settings:"wght" 300}
.hero .foot{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:end;border-top:1.5px solid var(--ink);padding-top:1.4rem}
.hero .foot p{max-width:26ch;font-size:clamp(1.2rem,2vw,1.7rem);line-height:1.25;font-weight:500}
.visits{text-align:right;line-height:1}
.visits b{display:block;font-size:clamp(3rem,9vw,8rem);font-weight:700;letter-spacing:-.04em}
.visits small{font-size:1rem;opacity:.7}

.band{background:var(--ink);color:var(--paper);display:grid;grid-template-columns:repeat(4,1fr);padding:clamp(3rem,7vw,6rem) 4vw;gap:2.5rem 2rem}
.band b{display:block;font-size:clamp(2.6rem,6vw,5.5rem);font-weight:300;letter-spacing:-.04em;line-height:1}
.band p{margin-top:.8rem;max-width:20ch;font-size:.98rem;opacity:.75;line-height:1.35}

section{padding:clamp(4.5rem,10vw,9rem) 4vw}
h2{margin:0 0 clamp(2rem,5vw,4rem);font-size:clamp(2.4rem,7vw,6rem);font-weight:700;line-height:.95;letter-spacing:-.04em}
.about{display:grid;grid-template-columns:1.1fr 1fr;gap:4vw}
.about h2{margin:0}
.about .txt{display:grid;gap:1.3rem;max-width:46ch;font-size:clamp(1.05rem,1.3vw,1.3rem)}

.row{position:relative;isolation:isolate;background:#fff;color:#fff;border-top:1.5px solid var(--ink)}
.row:last-child{border-bottom:1.5px solid var(--ink)}
.row::before{content:"";position:absolute;inset:0;background:var(--ink);transform:scaleY(0);transform-origin:50% var(--o,100%);transition:transform .5s cubic-bezier(.7,0,.2,1);z-index:-1}
.row>*{mix-blend-mode:difference}
.row:hover::before,.row.open::before,.row:has(:focus-visible)::before{transform:scaleY(1)}
.head{display:grid;grid-template-columns:minmax(9rem,13rem) 1fr minmax(0,1fr);gap:1rem 2rem;align-items:baseline;width:100%;padding:1.7rem 1.2rem}
.head h3{margin:0;font-size:clamp(1.8rem,4.5vw,3.8rem);font-weight:600;letter-spacing:-.035em;line-height:1;transition:transform .45s cubic-bezier(.7,0,.2,1)}
.row:hover .head h3{transform:translateX(.6rem)}
.head span{font-size:.98rem;opacity:.8}
.more{display:grid;grid-template-rows:0fr;transition:grid-template-rows .55s cubic-bezier(.7,0,.2,1)}
.row.open .more{grid-template-rows:1fr}
.more>div{overflow:hidden;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:1.5rem 3rem;align-items:start;padding:0 1.2rem 0 calc(min(13rem,25vw) + 3.2rem)}
.more p{padding-bottom:2rem;max-width:60ch;font-size:1.08rem}
.skill{display:grid;grid-template-columns:1fr 1fr;gap:1rem 2rem;padding:1.7rem 1.2rem;align-items:baseline}
.skill h3{margin:0;font-size:clamp(1.6rem,3.6vw,3rem);font-weight:600;letter-spacing:-.035em;line-height:1;transition:transform .45s cubic-bezier(.7,0,.2,1)}
.skill:hover h3{transform:translateX(.6rem)}
.skill p{max-width:42ch}

footer{background:var(--ink);color:var(--paper);padding:clamp(4rem,9vw,8rem) 4vw 2rem}
footer h2{max-width:11ch;margin-bottom:2.5rem}
.btn{--b:#fff;background:#000;color:#fff;display:inline-block;position:relative;isolation:isolate;overflow:hidden;border:1.5px solid currentColor;border-radius:999px;padding:.95em 1.8em;font-weight:500;transition:color .35s,transform .25s}
.btn::before{content:"";position:absolute;inset:0;background:var(--b);transform:translateY(102%);border-radius:50% 50% 0 0/40% 40% 0 0;transition:transform .5s cubic-bezier(.7,0,.2,1),border-radius .5s;z-index:-1}
.btn .t{display:block;mix-blend-mode:difference}
.btn:hover::before{transform:none;border-radius:0}
.legal{display:flex;align-items:center;gap:.9rem;margin-top:clamp(4rem,10vw,9rem);padding-top:1.4rem;border-top:1.5px solid #fff;font-size:.98rem}
.legal .logo{display:inline-flex;transition:transform .8s cubic-bezier(.7,0,.2,1),transform .25s}
.legal .logo:hover svg{transform:rotate(360deg)}
.legal svg{display:block;transition:transform .8s cubic-bezier(.7,0,.2,1)}

.ld{position:fixed;inset:0;z-index:9998;background:#000;color:#fff;display:flex;align-items:flex-end;justify-content:space-between;padding:2vw 4vw;font-size:clamp(4rem,22vw,20rem);font-weight:700;letter-spacing:-.05em;line-height:.8;transition:transform 1.1s cubic-bezier(.8,0,.1,1)}
.ld.go{transform:translateY(-101%)}
.w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.14em;margin-bottom:-.14em}
.w>span{display:inline-block;transform:translateY(110%);transition:transform 1.1s cubic-bezier(.2,.8,.2,1) calc(var(--d)*90ms)}
.in .w>span{transform:none}
.rv{clip-path:inset(0 0 100% 0);transform:translateY(28px);transition:clip-path 1.1s cubic-bezier(.7,0,.2,1) calc(var(--i,0)*90ms),transform 1.1s cubic-bezier(.2,.8,.2,1) calc(var(--i,0)*90ms)}
.rv.in{clip-path:inset(0 0 -4px 0);transform:none}
#bar{position:fixed;top:0;left:0;right:0;height:3px;background:#fff;mix-blend-mode:difference;transform:scaleX(0);transform-origin:0 50%;z-index:60}
nav a.roll{display:inline-block;overflow:hidden;height:1.6em;line-height:1.6;vertical-align:top;background:none}
.roll span{display:block;transition:transform .55s cubic-bezier(.7,0,.2,1)}
.roll span::after{content:attr(data-t);display:block}
.roll:hover span{transform:translateY(-100%)}
.ch{display:inline-block}
.row:hover h3 .ch{animation:hop .6s ease-out calc(var(--k)*22ms) both}
@keyframes hop{40%{transform:translateY(-.07em)}}
.in .w:hover>span{transform:translateY(-.03em);transition:transform .3s;transition-delay:0s}
.legal svg path{transform-origin:12px 12px;animation:spin 6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@media (max-width:760px){
 .band{grid-template-columns:1fr 1fr}
 .about{grid-template-columns:1fr;gap:2rem}
 .head{grid-template-columns:1fr;gap:.4rem;padding:1.4rem .6rem}
 .more>div{grid-template-columns:1fr;padding:0 .6rem}
 .more p{padding-bottom:0;max-width:none}
 .skill{grid-template-columns:1fr;padding:1.4rem .6rem}
 .hero .foot{grid-template-columns:1fr}
 .visits{text-align:left}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
<noscript><style>.ld{display:none}</style></noscript>
</head>
<body>
<div id="ink-cursor" aria-hidden="true"></div>
<div class="ld" aria-hidden="true"><span id="pc">0</span><span>stars</span></div>

<nav>
 <a href="#top" data-mag>stars</a>
 <div class="links"><a href="#about" data-mag>About</a><a href="#work" data-mag>Work</a><a href="#skills" data-mag>Skills</a></div>
</nav>

<header class="hero" id="top">
 <h1 class="h1" aria-label="stars"><span aria-hidden="true">s</span><span aria-hidden="true">t</span><span aria-hidden="true">a</span><span aria-hidden="true">r</span><span aria-hidden="true">s</span></h1>
 <div class="foot">
  <p>I keep big online communities safe, fair and fun to be in.</p>
  <div class="visits"><b><span id="v" data-to="280">280</span>M+</b><small>visits and counting.</small></div>
 </div>
</header>

<div class="band">
 <div><b data-to="200" data-suf="k+">200k+</b><p>active users at Korone</p></div>
 <div><b data-to="40" data-suf="k">40k</b><p>new people in 3 to 4 days, and it held</p></div>
 <div><b data-to="0.49" data-dec="2">0.49</b><p>Gini. Wealth stays spread out.</p></div>
 <div><b data-to="9" data-suf="%">9%</b><p>whale dominance. No one runs the economy.</p></div>
</div>

<section class="about" id="about">
 <h2>Hi, I'm stars.</h2>
 <div class="txt">
  <p>I've been on Roblox since 2014 and trading since 2017. That background led me into game economy design, and I've spent the past five years working on Roblox game systems, marketplaces and monetization.</p>
  <p>At Korone, I managed an economy serving more than 200,000 active users and independently designed its economic structure, including sinks for Robux distribution. At Bloxstrike, I led operations and acquisition, coordinated development, checked work quality and handled marketing.</p>
  <p>I'm studying Business Administration and Linguistics with a minor in Economics. I also interned in HR at Raw Brani, working on logistics, personnel management, product launch concepts and influencer coordination.</p>
 </div>
</section>

<section id="work">
 <h2>Where I've worked</h2>
 <div class="list">
  <div class="row open">
   <button class="head" data-hover><span>Jul 2025 to Aug 2026</span><h3>Korone</h3><span>Economy Manager &amp; Lead Game Economist</span></button>
   <div class="more"><div><p>Managed an economy serving over 200k active users and designed its economic structure independently. Introduced complex economic sinks for Robux distribution. The community maintained a Gini of 0.49 and 9% whale dominance while handling a wave of 40k new members. I also improved how staff handled OCTA support tickets.</p></div></div>
  </div>
  <div class="row">
   <button class="head" data-hover><span>2025 to 2026</span><h3>Raw Brani</h3><span>Human Resources Intern</span></button>
   <div class="more"><div><p>Oversaw logistics and helped manage personnel. Contributed ideas for product launches and marketing, and played a leading role in bringing influencers together for promotional activities.</p></div></div>
  </div>
  <div class="row">
   <button class="head" data-hover><span>Oct 2023 to Jan 2024</span><h3>Learning Resources</h3><span>Head of Education</span></button>
   <div class="more"><div><p>A developer community that grew out of a QA testing crew. I wrote clear learning material, worked on retention, and kept the space safe for people to share what they think.</p></div></div>
  </div>
  <div class="row">
   <button class="head" data-hover><span>Feb 2022 to Jun 2024</span><h3>DIM-SIN Studios</h3><span>Bloxstrike - Head of Operations &amp; Head of Acquisition</span></button>
   <div class="more"><div><p>The studio behind Bloxstrike, and I'm one of the original creators and founders of the game. It was nominated for Best Shooter Experience at the 2026 Roblox RIA Awards, has passed 270M+ visits and is still counting. Past 2025, Bloxstrike became the property of Swipe Games. Alongside building it, I ran PR and socials, managed the dev and moderation teams, hired people to our standard, and QA tested.</p></div></div>
  </div>
 </div>
</section>

<section id="skills">
 <h2>What I'm good at</h2>
 <div class="list">
  <div class="row skill" data-hover><h3>Safe communities</h3><p>Moderation people respect, and a team that stays close to the members it looks after.</p></div>
  <div class="row skill" data-hover><h3>PR that sounds human</h3><p>Ideas that keep members and advertisers happy at the same time.</p></div>
  <div class="row skill" data-hover><h3>Healthy economies</h3><p>Light rules, fair systems, and numbers I can back up.</p></div>
  <div class="row skill" data-hover><h3>A bit of everything</h3><p>I'm not a master of one thing. I'm good at many, and I turn weak spots into strengths.</p></div>
 </div>
</section>

<footer>
 <h2>Thanks for stopping by.</h2>
 <a class="btn" href="#top" data-mag><span class="t">Back to top</span></a>
 <div class="legal">
  <a class="logo" href="#top" data-mag aria-label="Copyright"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10.5" stroke-width="1.5"/><path d="M15.5 9.2a4.2 4.2 0 1 0 0 5.6" stroke-width="1.7" stroke-linecap="round"/></svg></a>
  <span>2026. All rights reserved to stars.</span>
 </div>
</footer>

<script>
(function () {
  'use strict';

  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var inkCursor = document.getElementById('ink-cursor');
  if (finePointer && inkCursor) {
    addEventListener('pointermove', function (event) {
      if (event.pointerType && event.pointerType !== 'mouse') return;
      inkCursor.style.left = event.clientX + 'px';
      inkCursor.style.top = event.clientY + 'px';
      var target = event.target;
      inkCursor.classList.toggle('hovering', !!(target && target.closest && target.closest('a, button')));
      document.documentElement.classList.add('ink-cursor-active');
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', function () {
      document.documentElement.classList.remove('ink-cursor-active');
    });
    addEventListener('blur', function () {
      document.documentElement.classList.remove('ink-cursor-active');
    });
  }
  var rows = Array.from(document.querySelectorAll('#work .row'));
  var loader = document.querySelector('.ld');
  var progress = document.createElement('div');
  progress.id = 'bar';
  document.body.appendChild(progress);

  // Experience details stay keyboard-accessible and only one panel opens at a time.
  rows.forEach(function (row, index) {
    var button = row.querySelector('.head');
    var panel = row.querySelector('.more');
    panel.id = 'work-details-' + (index + 1);
    button.type = 'button';
    button.setAttribute('aria-controls', panel.id);
    button.setAttribute('aria-expanded', row.classList.contains('open') ? 'true' : 'false');
    button.addEventListener('click', function () {
      var wasOpen = row.classList.contains('open');
      rows.forEach(function (item) {
        item.classList.remove('open');
        item.querySelector('.head').setAttribute('aria-expanded', 'false');
      });
      if (!wasOpen) {
        row.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
    row.addEventListener('pointerenter', function (event) {
      var bounds = row.getBoundingClientRect();
      row.style.setProperty('--o', event.clientY < bounds.top + bounds.height / 2 ? '0%' : '100%');
    });
  });

  // Smooth number reveals without modifying the mouse pointer or heading position.
  function showCounter(element) {
    if (!element || element.dataset.counted === 'true') return;
    element.dataset.counted = 'true';
    var target = Number(element.dataset.to);
    var decimals = Number(element.dataset.dec || 0);
    var suffix = element.dataset.suf || '';
    var finalText = target.toFixed(decimals) + suffix;
    if (reducedMotion) {
      element.textContent = finalText;
      return;
    }
    var begin = performance.now();
    function step(now) {
      var t = Math.min(1, (now - begin) / 1200);
      var eased = 1 - Math.pow(1 - t, 4);
      element.textContent = (target * eased).toFixed(decimals) + suffix;
      if (t < 1) requestAnimationFrame(step);
      else element.textContent = finalText;
    }
    requestAnimationFrame(step);
  }

  var bandCounters = Array.from(document.querySelectorAll('.band b'));
  if ('IntersectionObserver' in window && !reducedMotion) {
    var counterObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          showCounter(entry.target);
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.35 });
    bandCounters.forEach(function (element) { counterObserver.observe(element); });
  } else {
    bandCounters.forEach(showCounter);
  }

  // Reveal copy once, with no scroll-speed rotation or elastic letter physics.
  document.querySelectorAll('h2').forEach(function (heading) {
    var value = heading.textContent;
    heading.setAttribute('aria-label', value);
    heading.innerHTML = value.split(' ').map(function (word, index) {
      return '<span class="w" aria-hidden="true"><span style="--d:' + index + '">' + word + '</span></span>';
    }).join(' ');
  });

  var revealItems = Array.from(document.querySelectorAll('h2, .row, .txt p'));
  revealItems.forEach(function (item, index) {
    if (!item.matches('h2')) {
      item.classList.add('rv');
      item.style.setProperty('--i', index % 5);
    }
  });
  if ('IntersectionObserver' in window && !reducedMotion) {
    var revealObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    revealItems.forEach(function (item) { revealObserver.observe(item); });
  } else {
    revealItems.forEach(function (item) { item.classList.add('in'); });
  }

  document.querySelectorAll('nav a').forEach(function (link) {
    var label = link.textContent;
    link.classList.add('roll');
    link.innerHTML = '<span data-t="' + label + '">' + label + '</span>';
  });
  document.querySelectorAll('.row h3').forEach(function (heading) {
    var index = 0;
    heading.innerHTML = heading.textContent.split('').map(function (character) {
      return character === ' ' ? ' ' : '<span class="ch" style="--k:' + (index++) + '">' + character + '</span>';
    }).join('');
  });

  var progressQueued = false;
  function updateProgress() {
    var available = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    progress.style.transform = 'scaleX(' + (scrollY / available) + ')';
    progressQueued = false;
  }
  addEventListener('scroll', function () {
    if (!progressQueued) {
      progressQueued = true;
      requestAnimationFrame(updateProgress);
    }
  }, { passive: true });
  addEventListener('resize', updateProgress);
  updateProgress();

  function beginPage() { showCounter(document.getElementById('v')); }
  if (reducedMotion || !loader) {
    if (loader) loader.remove();
    beginPage();
  } else {
    var percentage = document.getElementById('pc');
    var start = performance.now();
    function load(now) {
      var t = Math.min(1, (now - start) / 700);
      percentage.textContent = Math.round(100 * (1 - Math.pow(1 - t, 3)));
      if (t < 1) {
        requestAnimationFrame(load);
      } else {
        loader.classList.add('go');
        setTimeout(function () { loader.remove(); }, 1150);
        beginPage();
      }
    }
    requestAnimationFrame(load);
  }
})();
</script>
</body>
</html>
